# Termux/Bionic port: stdlib/libblastrampoline_jll/src/libblastrampoline_jll.jl
#
# Load Julia's own libblastrampoline from its installed path, computed per
# process instead of via dlpath().
--- a/stdlib/libblastrampoline_jll/src/libblastrampoline_jll.jl
+++ b/stdlib/libblastrampoline_jll/src/libblastrampoline_jll.jl
@@ -27,8 +27,20 @@
 end
 
 function __init__()
-    global libblastrampoline_handle = dlopen(libblastrampoline)
-    global libblastrampoline_path = dlpath(libblastrampoline_handle)
+    # Julia builds libblastrampoline itself (USE_SYSTEM_LIBBLASTRAMPOLINE=0) and
+    # installs it in $(prefix)/lib/julia, which is `usr/lib/julia` while the system
+    # image is generated and $PREFIX/lib/julia on the device.  The path is computed
+    # here rather than as a module-level `const`, because a top-level `const` in a
+    # stdlib is frozen into sys.so and would keep the build machine's prefix.
+    # `dlpath()` is not consulted: on Bionic it used to answer NULL for a loaded
+    # handle, which turned the path into a silent "".
+    lbt_path = joinpath(dirname(Sys.BINDIR), "lib", "julia", libblastrampoline)
+    global libblastrampoline_handle = dlopen(lbt_path; throw_error=false)
+    if libblastrampoline_handle === C_NULL
+        error("libblastrampoline_jll: could not dlopen ", lbt_path,
+              "; is libblastrampoline installed?")
+    end
+    global libblastrampoline_path = lbt_path
     global artifact_dir = dirname(Sys.BINDIR)
     LIBPATH[] = dirname(libblastrampoline_path)
     push!(LIBPATH_list, LIBPATH[])
