# Termux/Bionic port: src/support/dtypes.h
#
# Two independent collisions with bionic's headers.
#
# 1. Endianness macros.  dtypes.h reinvents the non-underscore names from the
#    underscore ones, but bionic's <sys/endian.h> defines them in the opposite
#    direction: LITTLE_ENDIAN 1234, BIG_ENDIAN 4321, BYTE_ORDER LITTLE_ENDIAN,
#    and only then __BYTE_ORDER as a *synonym* for BYTE_ORDER (lines 89-96,
#    unconditional).  Redefining BYTE_ORDER as __BYTE_ORDER therefore closes a
#    cycle - BYTE_ORDER -> __BYTE_ORDER -> BYTE_ORDER - the preprocessor stops
#    the recursion and reports "'BYTE_ORDER' is not defined, evaluates to 0"
#    (-Wundef).  Both sides then read 0, so `#if BYTE_ORDER == BIG_ENDIAN` is
#    true on a little-endian device: src/flisp/flisp.c compiled its big-endian
#    branch in run 37803324627 and died on the missing line continuation that
#    upstream's flisp.c:990 hides in that never-taken branch.  Leaving the
#    system's own values alone breaks the cycle and keeps the branch dead.
#
# 2. Bionic's sys/types.h already typedefs uint_t.
--- a/src/support/dtypes.h
+++ b/src/support/dtypes.h
@@ -94,10 +94,16 @@
 
 #ifdef _OS_LINUX_
 #include <endian.h>
+#ifndef LITTLE_ENDIAN
 #define LITTLE_ENDIAN  __LITTLE_ENDIAN
+#endif
+#ifndef BIG_ENDIAN
 #define BIG_ENDIAN     __BIG_ENDIAN
+#endif
+#ifndef BYTE_ORDER
 #define BYTE_ORDER     __BYTE_ORDER
 #endif
+#endif
 
 #if defined(__APPLE__) || defined(__FreeBSD__) || defined(__OpenBSD__)
 #include <machine/endian.h>
@@ -204,7 +210,13 @@
 #ifdef _P64
 #define TOP_BIT 0x8000000000000000
 #define NBITS 64
+// Bionic's <sys/types.h> typedefs uint_t as `unsigned int` unconditionally and
+// dtypes.h pulls that header in, so upstream's 64-bit typedef is a redefinition
+// error here.  uint_t only carries hash-sized values (src/gf.c, htable.inc);
+// int_t keeps its 64 bits, so flisp's NBITS==64 fixnum path is unaffected.
+#ifndef _OS_ANDROID_
 typedef uint64_t uint_t;  // preferred int type on platform
+#endif
 typedef int64_t int_t;
 #else
 #define TOP_BIT 0x80000000
