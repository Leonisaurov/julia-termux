-if Base.USE_BLAS64
-    const libsuffix = "64_"
-else
-    const libsuffix = ""
+# The annotation is load-bearing for `juliac --trim`.  A `const` assigned inside
+# a conditional keeps a binding the trim verifier cannot narrow, so every string
+# interpolation built from it is refused as
+#   Verifier error: unresolved call ... Core._apply_iterate(Base._string, a::Any)
+# coming out of load_openblas().  Measured on the device 2026-10-10: the same
+# expression passes the verifier when the binding is typed, and a hello world
+# compiled with --trim=safe stops failing inside this stdlib's __init__.
+const libsuffix::String = Base.USE_BLAS64 ? "64_" : ""
+
+# Precomputed at module load.  Inside load_openblas() the same interpolation is a
+# variadic string(...) call, and juliac's --trim verifier cannot resolve the
+# Core._apply_iterate(Base._string, a::Any) splat it expands to; measured on the
+# device 2026-10-10, where a faithful replica of this function passes as soon as
+# the interpolation moves out here.
+
+# Everything below has to be computed inside `__init__()`, not at module top
+# level: a top-level `const` in a stdlib is frozen into the system image, so a
+# path built from `Sys.BINDIR` there would keep the build machine's prefix.
+#
+# `dlpath()` alone is not acceptable either: it routes through
+# jl_pathname_for_handle(), which used to return NULL on Bionic, leaving
+# libopenblas_path == "" in the image; libblastrampoline then forwarded to "" and
+# every Julia process died during BLAS init.
+const openblas_soname = "libopenblas$(libsuffix).so"
+
+function load_openblas()
+    # Termux ships OpenBLAS as a plain library in $(prefix)/lib; there is no
+    # artifact directory.  During system-image generation Sys.BINDIR is the
+    # staged usr/bin, so the staged copy is a candidate too, and the bare soname
+    # covers whichever layout the loader's RUNPATH can actually see.
+    libdir = joinpath(dirname(Sys.BINDIR), "lib")
+    candidates = (joinpath(libdir, openblas_soname),
+                  joinpath(libdir, "julia", openblas_soname),
+                  openblas_soname)
+    for candidate in candidates
+        # A miss here is just the next candidate, and `dlopen` throws by default.
+        handle = dlopen(candidate; throw_error=false)
+        handle === nothing && continue
+        isfile(candidate) && return (handle, normpath(candidate))
+        path = try
+            dlpath(handle)
+        catch err
+            Base.@warn "OpenBLAS_jll: dlpath() of $(candidate) failed" exception=(err, catch_backtrace())
+            ""
+        end
+        isempty(path) || return (handle, path)
+    end
+    error("OpenBLAS_jll: none of ", join(candidates, ", "),
+          " could be dlopen'ed; is the libopenblas package installed?")
 end
 
