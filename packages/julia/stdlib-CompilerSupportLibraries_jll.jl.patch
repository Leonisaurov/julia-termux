+# not attempted at all.
+function load_runtime_library(name)
+    isempty(name) && return (C_NULL, "")
+    handle = dlopen(name; throw_error = false)
+    handle === nothing && return (C_NULL, "")
+    path = try
+        dlpath(handle)
+    catch err
+        Base.@warn "CompilerSupportLibraries_jll: dlpath() of $(name) failed" exception=(err, catch_backtrace())
+        ""
+    end
+    isempty(path) && return (C_NULL, "")
+    return (handle, path)
+end
